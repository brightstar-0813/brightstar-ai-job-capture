# Slack Incoming Webhook (optional — skip notify if empty)
SLACK_WEBHOOK_URL=

# Local API (npm start)
PORT=3847

# Capture settings
SEARCH_Q=SWE Backend AI/ML
SEARCH_QUERIES=Software Engineer,Backend Engineer,AI Engineer,ML Engineer,Machine Learning Engineer,AI/ML Engineer,LLM Engineer,Generative AI Engineer
MAX_PAGES=5
PAGE_SIZE=20
HEADLESS=true
DELAY_MS=800
RECENT_DAYS=3
CRON_SCHEDULE=0 5,17 * * *

# Dual CSV exports
CSV_US_FILE=jobs_us_latest.csv
CSV_AU_FILE=jobs_au_latest.csv
DATA_DIR=download
STORE_FILE=store.json

# Existing Playwright / board sources
CAPTURE_DICE=true
# false = JobRight via Chrome extension (recommended). true = Playwright + jobright:login
CAPTURE_JOBRIGHT=false
JOBRIGHT_MAX_PAGES=5
JOBRIGHT_AUTH_PATH=download/jobright-auth.json
JOBRIGHT_TITLES=Software Engineer,Backend Engineer,AI Engineer,ML Engineer,Machine Learning Engineer,AI/ML Engineer,LLM Engineer,Generative AI Engineer,Senior Software Engineer,Senior Backend Engineer,Senior AI Engineer,Senior ML Engineer
CAPTURE_BUILTIN=true
CAPTURE_GREENHOUSE=true
CAPTURE_ZIPRECRUITER=true
CAPTURE_MONSTER=true

# Public remote-job APIs (no login)
CAPTURE_REMOTIVE=true
CAPTURE_JOBICY=true
CAPTURE_HIMALAYAS=true
CAPTURE_ARBEITNOW=true
CAPTURE_REMOTEOK=true
CAPTURE_WEWORKREMOTELY=true

# Public ATS boards
CAPTURE_LEVER=true
CAPTURE_ASHBY=true
# Comma-separated board tokens / company slugs (optional overrides)
# GREENHOUSE_BOARDS=stripe,datadog,canva,atlassian
# LEVER_COMPANIES=netflix,shopify,canva
# ASHBY_ORGS=openai,anthropic,linear

# AU Seek (Playwright; no public API)
CAPTURE_SEEK=true
